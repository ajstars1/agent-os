# The Supabase project for aos connect (its own project, never the personal aos-control one).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...). Safe in the browser: row level security does the protecting.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of this app, no trailing slash. Used in sign-in redirects and the connector link.
NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app

# Phone channel (optional). Without these the Telegram bot is off and /app hides "Connect Telegram".
# Bot username from @BotFather, without the @.
NEXT_PUBLIC_TELEGRAM_BOT=
# Server only. Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Server only. Random string (32+ letters/digits); Telegram sends it back with every update.
TELEGRAM_WEBHOOK_SECRET=
# Server only. Supabase secret key (sb_secret_...). Used for nothing but the channel_* database functions.
SUPABASE_SECRET_KEY=

# The vault (optional). Without it, "Email sending" is hidden and nothing is stored.
# Server only. 32 random bytes, base64url: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`. It seals saved logins;
# it is never in the database. If it is lost, people reconnect their email.
VAULT_KEY=
