[Unit]
Description=aos-watch: plain-logic watchdog for the Discord agent (relays stuck permission prompts, restarts it if it dies)
After=aos-discord.service

[Service]
WorkingDirectory=/home/ubuntu/Developer/Ayush/agent-os/control
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.bun/bin/bun watchdog/aos-watch.ts
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
