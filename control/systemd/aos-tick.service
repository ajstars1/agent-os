[Unit]
Description=aos runner tick: ping overdue tasks, start Claude on due auto tasks

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/Developer/Ayush/agent-os/control
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
ExecStart=/home/ubuntu/.bun/bin/bun runner/tick.ts
TimeoutStartSec=30min
