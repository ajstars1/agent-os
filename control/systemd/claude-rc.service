[Unit]
Description=Claude Remote Control server: start sessions on this machine from the Claude phone app
After=graphical-session.target
# At most 5 starts in 10 min; then systemd stops retrying instead of crash-looping into the journal.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=/home/ubuntu/Developer/Ayush
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
ExecStart=/home/ubuntu/.local/bin/claude remote-control --name linux --spawn same-dir --capacity 4 --permission-mode auto --chrome
Restart=always
RestartSec=30
# Its stdout is a status display that flooded journald; errors still go to the journal on stderr.
StandardOutput=null

[Install]
WantedBy=default.target
